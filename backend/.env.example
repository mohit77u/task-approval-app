NODE_ENV=development
PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=taskapp
DB_PASSWORD=taskapp
DB_NAME=taskapp
DB_SSL=false
# DB_SSL_CA=   (PEM text; use \n for line breaks when set as a single-line variable)

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL_DAYS=365

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
FRONTEND_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the API. Must be >= 1 in production (Render, plus Vercel's rewrite).
TRUST_PROXY_HOPS=0
THROTTLING_ENABLED=true
# Swagger UI at /api/docs. Unset: on outside production, off in production. Set to true to expose it in production.
# ENABLE_SWAGGER=

# Optional overrides for the seeded demo accounts' passwords (npm run seed). Unset: the demo values in the README.
# SEED_ADMIN_PASSWORD=
# SEED_EMPLOYEE_PASSWORD=
